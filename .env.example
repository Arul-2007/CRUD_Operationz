# MongoDB Atlas connection string (do not commit real passwords)
# Windows PowerShell:  $env:MONGODB_URI = (Get-Content .env | Select-String "MONGODB_URI" | ForEach-Object { $_.Line.Split("=")[1] })
# Copy this line into .env and replace the placeholders, then set the env var:
MONGODB_URI=mongodb+srv://arul:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
